{
  "version": 1,
  "name": "read-later.calm-editorial",
  "note": "Platform-neutral source of truth for the Calm Editorial design language. Layer 1 primitive, layer 2 semantic, layer 3 platform binding. A view never reads a hex or a point: it reads a semantic token. Generate with tools/tokens/generate.py; check with --check.",
  "modes": [
    "light",
    "dark"
  ],
  "primitive": {
    "color": {
      "white": "#FFFFFF",
      "black": "#000000",
      "sand.50": "#FFFCF7",
      "sand.100": "#FFF7ED",
      "sand.150": "#F7F3EC",
      "sand.175": "#F1EDE4",
      "sand.250": "#E7E0D9",
      "ink.0": "#FFFFFF",
      "ink.200": "#E8E6E1",
      "ink.300": "#C9CDD2",
      "ink.500": "#A8B0B8",
      "ink.600": "#5B6570",
      "ink.700": "#333A42",
      "ink.750": "#242A30",
      "ink.760": "#23282E",
      "ink.780": "#2C333A",
      "ink.800": "#1E2226",
      "ink.820": "#1B1F24",
      "ink.850": "#262B31",
      "ink.900": "#191C1F",
      "ink.950": "#121417",
      "blue.100": "#DCE9F5",
      "blue.300": "#7FB3D5",
      "blue.650": "#2C4A63",
      "blue.700": "#334E68",
      "blue.750": "#2C4A66",
      "amber.100": "#FFF0E6",
      "amber.200": "#FDE68A",
      "amber.250": "#E8D9B0",
      "amber.300": "#FDBA74",
      "amber.400": "#C9A94E",
      "amber.500": "#F59E0B",
      "amber.600": "#B45309",
      "amber.700": "#854D0E",
      "amber.750": "#8A6D1B",
      "amber.800": "#78350F",
      "amber.900": "#9A3412",
      "amber.950": "#7C4A1E",
      "amber.975": "#4A4030",
      "olive.200": "#EFE7D3",
      "olive.250": "#E0D3B0",
      "olive.600": "#7A6A3A",
      "olive.850": "#2E2A20",
      "olive.900": "#453D2A",
      "amber.150": "#D8C48C",
      "amber.850": "#3A2A1F"
    }
  },
  "semantic": {
    "color": {
      "page.paper": {
        "light": "sand.50",
        "dark": "ink.950",
        "description": "Reader and entry background."
      },
      "page.surface": {
        "light": "white",
        "dark": "ink.800",
        "description": "Card, player bar, chrome."
      },
      "page.raised": {
        "light": "sand.100",
        "dark": "ink.850",
        "description": "Hold badge fill, mono chip."
      },
      "text.body": {
        "light": "ink.900",
        "dark": "ink.200",
        "description": "Prose ink."
      },
      "text.meta": {
        "light": "ink.600",
        "dark": "ink.500",
        "description": "Subhead, clock, provenance."
      },
      "line.hair": {
        "light": "sand.250",
        "dark": "ink.700",
        "description": "Divider, field border."
      },
      "brand.link": {
        "light": "blue.700",
        "dark": "blue.300",
        "description": "Quote rule, track fill, marker ink."
      },
      "action.fill": {
        "light": "blue.700",
        "dark": "blue.650",
        "description": "Primary button fill. Stays dark in both modes so white ink keeps its contrast."
      },
      "action.ink": {
        "light": "white",
        "dark": "white",
        "description": "Ink on a primary button."
      },
      "ghost.fill": {
        "light": "white",
        "dark": "ink.750",
        "description": "Secondary button fill on a card."
      },
      "wash.fill": {
        "light": "amber.200",
        "dark": "amber.700",
        "description": "The word the voice is on."
      },
      "wash.ink": {
        "light": "amber.800",
        "dark": "amber.200",
        "description": "Ink inside the wash."
      },
      "rule.paused": {
        "light": "amber.250",
        "dark": "amber.975",
        "description": "Frozen wash fill while paused."
      },
      "rule.ring": {
        "light": "amber.750",
        "dark": "amber.400",
        "description": "Frozen wash ring while paused."
      },
      "mark.selected": {
        "light": "blue.100",
        "dark": "blue.750",
        "description": "The word the reader tapped."
      },
      "mark.saved": {
        "light": "amber.900",
        "dark": "amber.300",
        "description": "Saved-phrase rule. Tier 2."
      },
      "mark.savedFill": {
        "light": "amber.100",
        "dark": "amber.850",
        "description": "Saved-phrase fill. Tier 2."
      },
      "skip.surface": {
        "light": "sand.150",
        "dark": "ink.820",
        "description": "A block the voice skips: it keeps its own surface."
      },
      "skip.border": {
        "light": "sand.250",
        "dark": "ink.780",
        "description": "Skip block edge."
      },
      "skip.ink": {
        "light": "ink.900",
        "dark": "ink.300",
        "description": "Reduced ink inside a skip block."
      },
      "chip.surface": {
        "light": "olive.200",
        "dark": "olive.850",
        "description": "Skip chip tile."
      },
      "chip.ink": {
        "light": "olive.600",
        "dark": "amber.150",
        "description": "Skip chip label."
      },
      "chip.border": {
        "light": "olive.250",
        "dark": "olive.900",
        "description": "Skip chip edge."
      },
      "code.inlineSurface": {
        "light": "sand.175",
        "dark": "ink.760",
        "description": "Inline code fill."
      },
      "mark.coincide": {
        "light": "amber.600",
        "dark": "amber.500",
        "description": "Ring when the tap lands on the spoken word."
      },
      "veil.scrim": {
        "light": {
          "color": "ink.900",
          "alpha": 0.28
        },
        "dark": {
          "color": "black",
          "alpha": 0.28
        },
        "description": "Card dim."
      },
      "hold.surface": {
        "light": "amber.100",
        "dark": "amber.850",
        "description": "Hold badge fill."
      },
      "hold.ink": {
        "light": "amber.900",
        "dark": "amber.300",
        "description": "Hold badge ink."
      },
      "hold.border": {
        "light": "amber.300",
        "dark": "amber.950",
        "description": "Hold badge edge."
      }
    },
    "typography": {
      "body": {
        "family": "serif",
        "size": 19,
        "line": 31,
        "weight": "regular",
        "description": "Reader prose."
      },
      "title": {
        "family": "serif",
        "size": 28,
        "line": 34,
        "weight": "semibold",
        "description": "Article title."
      },
      "heading": {
        "family": "serif",
        "size": 22,
        "weight": "semibold",
        "description": "Heading block."
      },
      "caption": {
        "family": "sans",
        "size": 13,
        "weight": "regular",
        "description": "Meta line, provenance."
      },
      "player": {
        "family": "sans",
        "size": 15,
        "weight": "regular",
        "monospacedDigit": true,
        "description": "Player clock."
      },
      "lookupWord": {
        "family": "serif",
        "size": 22,
        "weight": "medium",
        "description": "Tapped word in the card."
      },
      "gloss": {
        "family": "sans",
        "size": 17,
        "weight": "regular",
        "description": "Gloss text, Traditional Chinese."
      },
      "chip": {
        "family": "mono",
        "size": 10,
        "weight": "bold",
        "description": "Skip chip label, uppercase, tracked."
      },
      "code": {
        "family": "mono",
        "size": 12,
        "weight": "regular",
        "description": "Code block."
      },
      "note": {
        "family": "sans",
        "size": 14,
        "weight": "regular",
        "description": "Footnote body."
      },
      "mono": {
        "family": "mono",
        "size": 11,
        "weight": "regular",
        "description": "NOTES label, footnote marker."
      }
    },
    "space": {
      "inlineGap": {
        "value": 4,
        "description": "Chip inset, tight pairs."
      },
      "controlGap": {
        "value": 8,
        "description": "Adjacent controls."
      },
      "stackGap": {
        "value": 12,
        "description": "Card rows."
      },
      "paragraphGap": {
        "value": 16,
        "description": "Between reader blocks."
      },
      "screenGutter": {
        "value": 20,
        "description": "Page side margin, card padding."
      },
      "breathingRoom": {
        "value": 32,
        "description": "Top room above the title."
      }
    },
    "radius": {
      "chip": {
        "value": 4,
        "description": "Wash chip."
      },
      "inner": {
        "value": 8,
        "description": "Skip inner table."
      },
      "button": {
        "value": 10,
        "description": "Buttons and fields."
      },
      "card": {
        "value": 12,
        "description": "Card, skip shell, sheet."
      },
      "sheet": {
        "value": 16,
        "description": "Sheet top, mock value."
      },
      "pill": {
        "value": 999,
        "description": "Capsule."
      }
    },
    "size": {
      "minTarget": {
        "value": 44,
        "description": "Smallest control, both axes."
      },
      "maxLineWidth": {
        "value": 640,
        "description": "Reading measure."
      },
      "playerBar": {
        "value": 58,
        "description": "Bar height, including the 44 pt hit row."
      },
      "chrome": {
        "value": 44,
        "description": "Reader top bar."
      }
    },
    "motion": {
      "wash": {
        "duration": 150,
        "curve": "linear",
        "description": "Wash word swap."
      },
      "sheet": {
        "duration": 180,
        "curve": "easeInOut",
        "description": "Card in and out."
      },
      "screen": {
        "duration": 180,
        "curve": "easeInOut",
        "description": "Screen swap."
      },
      "entryProgress": {
        "duration": 300,
        "curve": "easeInOut",
        "description": "Entry progress bar."
      }
    }
  },
  "platform": {
    "swift": {
      "source": "packages/ReadLaterUI/Sources/ReadLaterUI/Generated/ThemeTokens.swift",
      "symbolTemplate": "{camelCase}",
      "colorHelper": "Theme.themedColor(light:dark:)",
      "note": "Component layer is SwiftUI; primitive and semantic layers are generated. Fonts resolve to system faces, so the type ramp is generated as points and weights, not font files.",
      "names": {
        "page.paper": "paper",
        "page.surface": "surface",
        "page.raised": "surfaceRaised",
        "text.body": "ink",
        "text.meta": "inkSecondary",
        "line.hair": "line",
        "brand.link": "brand",
        "action.fill": "actionFill",
        "action.ink": "actionInk",
        "ghost.fill": "ghostFill",
        "wash.fill": "currentWordBg",
        "wash.ink": "currentWordInk",
        "rule.paused": "pausedWash",
        "rule.ring": "pausedRing",
        "mark.selected": "selection",
        "mark.saved": "savedMark",
        "mark.savedFill": "savedWash",
        "skip.surface": "skipSurface",
        "skip.border": "skipBorder",
        "skip.ink": "skipInk",
        "chip.surface": "chipSurface",
        "chip.ink": "chipInk",
        "chip.border": "chipBorder",
        "code.inlineSurface": "inlineCodeSurface",
        "mark.coincide": "coincidenceRing",
        "veil.scrim": "scrim",
        "hold.surface": "holdSurface",
        "hold.ink": "holdInk",
        "hold.border": "holdBorder"
      },
      "fontNames": {
        "note": "footnote"
      }
    },
    "css": {
      "source": "design/generated/tokens.css",
      "symbolTemplate": "--{kebab-case}",
      "note": "For prototypes and docs. Dark mode follows prefers-color-scheme and the [data-theme=dark] attribute."
    },
    "kotlin": {
      "source": "design/generated/Tokens.kt",
      "symbolTemplate": "{camelCase}",
      "note": "Jetpack Compose. Two token objects, LightTokens and DarkTokens, plus a resolver. Android maps semantic colours only; component layer is Material 3 shape and typography. Dynamic Type becomes sp scaled units; the wash chip must be recomputed from glyph bounds, not from a fixed rect."
    },
    "xaml": {
      "source": "design/generated/Tokens.xaml",
      "symbolTemplate": "{PascalCase}Color",
      "note": "WinUI 3 ThemeDictionaries. Type ramp maps to TextBlock styles; the 44 pt target is 44 epx at 100 percent scaling and must scale with the system text scale."
    }
  },
  "layers": {
    "portable": [
      "primitive.color",
      "semantic.color",
      "semantic.typography",
      "semantic.space",
      "semantic.radius",
      "semantic.size",
      "semantic.motion"
    ],
    "platform": [
      "component geometry (SwiftUI/CSS/Compose/WinUI differ)",
      "font families (system faces differ)",
      "text scaling (Dynamic Type, sp, text scale)",
      "focus and hover states",
      "safe-area and keyboard insets"
    ]
  }
}
